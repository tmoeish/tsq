{{- $dot := . }}
{{- $type := .TypeInfo.TypeName }}
{{- $resultType := printf "%sResult" $type }}
{{- $var := printf "Result%s" $type }}

// Code generated by tsq-{{.TSQVersion}}. DO NOT EDIT.
package {{ .TypeInfo.Package.Name }}

import (
{{- if NeedsGeneratedSQLImport . }}
	tsqsql "database/sql"
{{- end }}
{{- if NeedsGeneratedTimeImport . }}
	tsqtime "time"
{{- end }}
	"github.com/tmoeish/tsq/v5"
)

// {{$resultType}} holds the column each field of {{$type}} is read from.
type {{$resultType}} struct {
{{- range $f := .Fields }}
	{{$f.Name}} tsq.ResultColumn[{{$type}}, {{ ValueType $f }}]
{{- end }}
}

// {{$var}} is the {{$type}} projection; select it with tsq.Select({{$var}}.Columns()...).
var {{$var}} = {{$resultType}}{
{{- range $f := .Fields }}
	{{$f.Name}}: {{ if $f.NullValue }}tsq.MapIntoNull{{ else }}tsq.MapInto{{ end }}({{$f.Column}}, func(holder *{{$type}}) *{{$f | FieldType}} {
		return &holder.{{$f.Name}}
	}, "{{$f.JSONTag}}"),
{{- end }}
}

// Columns returns every column of the projection, for Select.
func (r {{$resultType}}) Columns() []tsq.BoundColumn[{{$type}}] {
	return []tsq.BoundColumn[{{$type}}]{
{{- range $f := .Fields }}
		r.{{$f.Name}},
{{- end }}
	}
}
