{{- $dot := . }}
{{- $type := .TypeInfo.TypeName }}
{{- $ptype := printf "*%s" $type }}

// Code generated by tsq-{{.TSQVersion}}. DO NOT EDIT.
package {{ .TypeInfo.Package.Name }}

import (
{{- if NeedsGeneratedSQLImport . }}
	tsqsql "database/sql"
{{- end }}
{{- if NeedsGeneratedTimeImport . }}
	tsqtime "time"
{{- end }}
	"github.com/tmoeish/tsq/v5"
)

// =============================================================================
// Result Definition
// =============================================================================

// TSQOwner marks {{$type}} as a TSQ owner.
func ({{$dot.Receiver}} {{$type}}) TSQOwner() {}

// TSQResult marks {{$type}} as a TSQ result.
func ({{$dot.Receiver}} {{$type}}) TSQResult() {}

// {{$type}}__Cols lists every generated result column of {{$type}}, for Select.
var {{$type}}__Cols = []tsq.BoundColumn[{{$type}}]{
{{- range $f := .Fields }}
	{{$type}}_{{$f.Name}},
{{- end }}
}

// Column definitions for {{$type}} result fields.
var (
{{- range $f := .Fields }}
	{{$type}}_{{$f.Name}} = tsq.MapInto({{$f.Column}}, func(holder {{$ptype}}) *{{$f | FieldType}} {
		return &holder.{{$f.Name}}
	}, "{{$f.JSONTag}}")
{{- end }}
)
