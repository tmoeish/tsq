{{- $dot := . }}
{{- $type := .TypeInfo.TypeName }}
{{- $handle := printf "tsq%sTable" $type }}
{{- $varTbl := printf "Table%s" $type }}
{{- $varTblCols := printf "%s__Cols" $type }}
{{- $list := printf "[]*%s" $type }}
{{- $precv := printf "func (%s *%s) " .Receiver $type }}
{{- $FetchBy := printf "Fetch%sBy" $type }}
{{- $QueryBy := printf "Query%sBy" $type }}
{{- $pk := printf "%s_%s" $type .PrimaryKey }}

// Code generated by tsq-{{.TSQVersion}}. DO NOT EDIT.

package {{.TypeInfo.Package.Name}}

import (
	"context"
	tsqsql "database/sql"
	"fmt"
{{- range $p, $a := .Imports }}
{{- if and (ne $p "database/sql") (ne $p "time") }}
	{{$a}} "{{$p}}"
{{- end }}
{{- end }}
{{- if NeedsGeneratedTimeImport . }}
	tsqtime "time"
{{- end }}
	"github.com/tmoeish/tsq/v5"
	tsqdialect "github.com/tmoeish/tsq/v5/dialect"
)

// {{$handle}} is {{$varTbl}} before its definition; columns are declared on it.
var {{$handle}} = tsq.NewTable[{{$type}}]("{{.Table}}")

// Columns of {{$type}}.
var (
{{- range $f := .Fields }}
	{{$type}}_{{$f.Name}} = tsq.NewColumn({{$handle}}, "{{$f.Column}}", "{{$f.JSONTag}}", func(r *{{$type}}) *{{$f | FieldType}} { return &r.{{$f.Name}} })
{{- end }}
)

// {{$varTbl}} is the table descriptor of {{$type}}. It depends on every column, so
// package initialization completes the table before any query uses it.
var {{$varTbl}} = {{$handle}}.Define(tsq.TableSpec[{{$type}}]{
	Columns: []tsq.BoundColumn[{{$type}}]{
{{- range $f := .Fields }}
		{{$type}}_{{$f.Name}},
{{- end }}
	},
	PrimaryKey:    {{$pk}},
	AutoIncrement: {{ if $dot.AutoIncrement }}true{{ else }}false{{ end }},
{{- if $dot.VersionField }}
	Version:       {{$type}}_{{$dot.VersionField}},
{{- end }}
{{- if $dot.CreatedAtField }}
	CreatedAt:     {{$type}}_{{$dot.CreatedAtField}},
{{- end }}
{{- if $dot.UpdatedAtField }}
	UpdatedAt:     {{$type}}_{{$dot.UpdatedAtField}},
{{- end }}
{{- if $dot.DeletedAtField }}
	DeletedAt:     {{$type}}_{{$dot.DeletedAtField}},
{{- end }}
{{- if .SearchColumns }}
	Search: []tsq.SearchColumn{
	{{- range $f := .SearchColumns }}
		{{$type}}_{{$f}},
	{{- end }}
	},
{{- end }}
	Schema: []tsqdialect.ColumnSpec{
{{- range .Schema }}
		{
			Name: "{{ .Name }}",
			Type: tsqdialect.ColumnType{
	{{- if .RawType }}
				RawType: {{ printf "%q" .RawType }},
	{{- end }}
	{{- if .Kind }}
				Kind: {{ ColumnKindRef .Kind }},
	{{- end }}
	{{- if .Bits }}
				Bits: {{ .Bits }},
	{{- end }}
	{{- if .Unsigned }}
				Unsigned: true,
	{{- end }}
	{{- if .Nullable }}
				Nullable: true,
	{{- end }}
	{{- if .Size }}
				Size: {{ .Size }},
	{{- end }}
			},
	{{- if .PrimaryKey }}
			PrimaryKey: true,
	{{- end }}
	{{- if .AutoIncrement }}
			AutoIncrement: true,
	{{- end }}
	{{- if .Default }}
			Default: {{ printf "%q" .Default }},
	{{- end }}
		},
{{- end }}
	},
{{- if or .Uniques .Indexes }}
	Indexes: []tsq.TableIndex{
	{{- range $idx := .Uniques }}
		{Name: "{{$idx.Name}}", Unique: true, Fields: []string{{"{"}}{{ IndexFieldsToCols $dot $idx.Fields }}{{"}"}}},
	{{- end }}
	{{- range $idx := .Indexes }}
		{Name: "{{$idx.Name}}", Fields: []string{{"{"}}{{ IndexFieldsToCols $dot $idx.Fields }}{{"}"}}},
	{{- end }}
	},
{{- end }}
})

// {{$varTblCols}} lists every column of {{$type}}, for Select.
var {{$varTblCols}} = {{$varTbl}}.Columns()

{{- $active := "" }}
{{- if .DeletedAtField }}
	{{- $active = SoftDeleteActiveCond $type $dot.DeletedAtField (index $dot.FieldsByName $dot.DeletedAtField) }}
{{- end }}

// {{$QueryBy}}{{.PrimaryKey}} reads one {{$type}} by primary key; bind {{$pk}}.
var {{$QueryBy}}{{.PrimaryKey}} = tsq.
	Select({{$varTblCols}}...).
	From({{$varTbl}}).
	Where(
		{{- if $active }}
		{{$active}},
		{{- end }}
		{{$pk}}.EQ({{$pk}}.Param()),
	).
	MustBuild()

// {{$QueryBy}}{{.PrimaryKey}}In reads {{$type}} rows by a list of primary keys; bind {{$pk}} with BindList.
var {{$QueryBy}}{{.PrimaryKey}}In = tsq.
	Select({{$varTblCols}}...).
	From({{$varTbl}}).
	Where(
		{{- if $active }}
		{{$active}},
		{{- end }}
		{{$pk}}.In({{$pk}}.ListParam()),
	).
	MustBuild()

// {{$FetchBy}}{{.PrimaryKey}} returns the {{$type}} rows with the given primary keys,
// in the order given. It fails with an error wrapping sql.ErrNoRows when any of
// them is missing.
func {{$FetchBy}}{{.PrimaryKey}}(
	ctx context.Context,
	db tsq.Executor,
	{{ FieldSliceVarName $dot.PrimaryKey }} ...{{index $dot.FieldsByName $dot.PrimaryKey | FieldType}},
) ({{$list}}, error) {
	list, err := {{$QueryBy}}{{.PrimaryKey}}In.List(ctx, db, {{$pk}}.BindList({{ FieldSliceVarName $dot.PrimaryKey }}...))
	if err != nil {
		return nil, err
	}

	ordered, missing := matchByInputOrder({{ FieldSliceVarName $dot.PrimaryKey }}, list, func(row *{{$type}}) {{index $dot.FieldsByName $dot.PrimaryKey | FieldType}} {
		return row.{{$dot.PrimaryKey}}
	})
	if len(missing) > 0 {
		return nil, fmt.Errorf("fetch {{$type}} by {{$dot.PrimaryKey}} %v: %w", missing, tsqsql.ErrNoRows)
	}

	return ordered, nil
}
{{- range $ux := .Uniques }}
	{{- $name := JoinAnd $ux.Fields }}
	{{- $last := index $ux.Fields (Sub1 (len $ux.Fields)) }}

// {{$QueryBy}}{{$name}} reads one {{$type}} by unique index {{$ux.Name}}.
var {{$QueryBy}}{{$name}} = tsq.
	Select({{$varTblCols}}...).
	From({{$varTbl}}).
	Where(
		{{- if $active }}
		{{$active}},
		{{- end }}
		{{- range $f := $ux.Fields }}
		{{$type}}_{{$f}}.EQ({{$type}}_{{$f}}.Param()),
		{{- end }}
	).
	MustBuild()

// {{$FetchBy}}{{$name}} returns the {{$type}} rows matching unique index {{$ux.Name}},
// one per {{$last}} value, in the order given. It fails with an error wrapping
// sql.ErrNoRows when any of them is missing.
func {{$FetchBy}}{{$name}}(
	ctx context.Context,
	db tsq.Executor,
	{{- range $i, $f := $ux.Fields }}
	{{- if eq $f $last }}
	{{ FieldSliceVarName $f }} ...{{ index $dot.FieldsByName $f | FieldType }},
	{{- else }}
	{{ FieldVarName $f }} {{ index $dot.FieldsByName $f | FieldType }},
	{{- end }}
	{{- end }}
) ({{$list}}, error) {
	list, err := {{$QueryBy}}{{$name}}In.List(ctx, db,
		{{- range $f := $ux.Fields }}
		{{- if eq $f $last }}
		{{$type}}_{{$f}}.BindList({{ FieldSliceVarName $f }}...),
		{{- else }}
		{{$type}}_{{$f}}.Bind({{ FieldVarName $f }}),
		{{- end }}
		{{- end }}
	)
	if err != nil {
		return nil, err
	}

	ordered, missing := matchByInputOrderKey({{ FieldSliceVarName $last }}, list,
		func(row *{{$type}}) string { return lookupKey(row.{{$last}}) },
		func(input {{ index $dot.FieldsByName $last | FieldType }}) string { return lookupKey(input) },
	)
	if len(missing) > 0 {
		return nil, fmt.Errorf("fetch {{$type}} by {{$name}} %v: %w", missing, tsqsql.ErrNoRows)
	}

	return ordered, nil
}
{{- end }}
{{- range $idx := .Queries }}

// {{$QueryBy}}{{$idx.Name}} reads {{$type}} rows by index {{$idx.IndexName}}.
var {{$QueryBy}}{{$idx.Name}} = tsq.
	Select({{$varTblCols}}...).
	From({{$varTbl}}).
	Where(
		{{- if $active }}
		{{$active}},
		{{- end }}
	{{- range $i, $f := $idx.Fields }}
		{{- if and $idx.LastFieldIn (eq $i (Sub1 (len $idx.Fields))) }}
		{{$type}}_{{$f}}.In({{$type}}_{{$f}}.ListParam()),
		{{- else }}
		{{$type}}_{{$f}}.EQ({{$type}}_{{$f}}.Param()),
		{{- end }}
	{{- end }}
	).
	MustBuild()
{{- end }}

// Query{{$type}} reads every {{$type}} row{{ if $active }} that is not deleted{{ end }}; Page matches its search columns.
var Query{{$type}} = tsq.
	Select({{$varTblCols}}...).
	From({{$varTbl}}).
{{- if $active }}
	Where({{$active}}).
{{- end }}
{{- if .SearchColumns }}
	Search({{$varTbl}}.SearchColumns()...).
{{- end }}
	MustBuild()

// Insert inserts the row; see tsq.TableOf.Insert.
{{$precv}}Insert(ctx context.Context, db tsq.Executor) error {
	return {{$varTbl}}.Insert(ctx, db, {{$dot.Receiver}})
}

// Update updates the row; see tsq.TableOf.Update.
{{$precv}}Update(ctx context.Context, db tsq.Executor) error {
	return {{$varTbl}}.Update(ctx, db, {{$dot.Receiver}})
}

{{ if .DeletedAtField -}}
// Delete soft-deletes the row by stamping {{$dot.DeletedAtField}}; it drops out of every
// generated query. See tsq.TableOf.Delete.
{{- else -}}
// Delete removes the row. {{$type}} has no deleted_at column, so Delete and
// HardDelete are the same.
{{- end }}
{{$precv}}Delete(ctx context.Context, db tsq.Executor) error {
	return {{$varTbl}}.Delete(ctx, db, {{$dot.Receiver}})
}

// HardDelete removes the row from the table.
{{- if .DeletedAtField }} Unlike a soft delete, it cannot be undone.
{{- end }}
{{$precv}}HardDelete(ctx context.Context, db tsq.Executor) error {
	return {{$varTbl}}.HardDelete(ctx, db, {{$dot.Receiver}})
}
{{- if .DeletedAtField }}

// Active reports whether the row is not soft-deleted.
{{$precv}}Active() bool {
	return {{ SoftDeleteActiveExpr $dot.Receiver $dot.DeletedAtField (index $dot.FieldsByName $dot.DeletedAtField) }}
}
{{- end }}
